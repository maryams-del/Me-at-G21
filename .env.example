# ── Copy to .env.local for development. Placeholders only — never commit real values. ──

# Postgres (Neon pooled connection string in production)
DATABASE_URL=postgres://life:life@localhost:5432/life_dev

# Public origin of the app, used as WebAuthn origin + RP ID (must be HTTPS in production)
APP_ORIGIN=http://localhost:3000
# The single owner allowed to enroll. Anyone else is refused.
OWNER_EMAIL=owner@example.com

# 32-byte keys, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts TOTP seeds and protected fields at rest. Rotating requires re-encryption.
DATA_ENCRYPTION_KEY=
# Pepper for recovery-code / session / email-code verifiers.
AUTH_PEPPER=

# Shared secret the external scheduler sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# AI (server-side only). AI_PROVIDER=anthropic | offline   (offline = local rule-based parser, no data leaves the server)
AI_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email (Resend). Without a key, dev prints emails to the server console; production refuses to send.
RESEND_API_KEY=
EMAIL_FROM="Life Dashboard <security@your-domain.example>"

# Web push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Private Vercel Blob store token (Phase B documents)
BLOB_READ_WRITE_TOKEN=
